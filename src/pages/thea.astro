---
import Layout from "../layouts/Layout.astro";
import f1 from "../assets/Page_thea/f1.webp";
import f2 from "../assets/Page_thea/f2.webp";
import f3 from "../assets/Page_thea/f3.webp";
import f4 from "../assets/Page_thea/f4.webp";
import f5 from "../assets/Page_thea/f5.webp";
import f6 from "../assets/Page_thea/f6.webp";
import f7 from "../assets/Page_thea/f7.webp";
import fond2 from "../assets/fond2.webp";
---

    <Layout>
        
        <div class="">
            {/*SECTION IMAGES*/}
            <div class="flex flex-col gap-0 mb-8 sm:mb-12 md:mb-16 lg:mb-20 max-w-4xl md:max-w-none mx-auto">
                <div class="relative">
                  <img src={f1.src} alt="Image 1" class="w-full h-auto z-0 mt-24" />
                  <h1 class="absolute bottom-170 left-0 right-0 text-center text-white text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl" 
                    style="font-family: 'Climate Crisis';">
                    THÉA
                  </h1>
                </div>
                <img src={f2.src} alt="Image 2" class="w-full h-auto z-10" />
                <img src={f3.src} alt="Image 3" class="w-full h-auto -mt-10 sm:-mt-16 md:-mt-24 lg:-mt-32 xl:-mt-40" />
                <img src={f4.src} alt="Image 4" class="w-full h-auto z-10 -mt-2 sm:-mt-4 md:-mt-6 lg:-mt-8 xl:-mt-10" />
                <img src={f5.src} alt="Image 5" class="w-full h-auto" />
                <img src={f6.src} alt="Image 6" class="w-full h-auto -z-10 -mt-10 sm:-mt-16 md:-mt-24 lg:-mt-32 xl:-mt-40" />
                <img src={f7.src} alt="Image 7" class="w-full h-auto" />
            </div>

            {/*SECTION TEXTES EN GRILLE 2x3*/}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 md:gap-8 pb-8 sm:pb-12 md:pb-16 lg:pb-20 px-4 sm:px-6 md:px-8 lg:px-16 xl:px-24 2xl:px-35">
                {/* Bloc 1 : Titre THÉA + Description */}
                <div class="md:col-span-2">
                    <div
                        class="text-black"
                        style="font-family: 'Cal Sans'; font-size: 16px;"
                    >
                        <div
                            class="p-4 sm:p-5 md:p-6 lg:p-8"
                            style="
                                background-color: #ffffff;
                                border: 2px solid #000000;
                                box-shadow: inset 0 0 0 1px #000000;
                                outline: 1px solid #000000;
                            "
                        >
                            <div class="flex flex-col gap-3 sm:gap-4 md:gap-5 lg:gap-6">
                                <h1
                                    class="text-black text-center text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl mb-1 sm:mb-2"
                                    style="font-family: 'Climate Crisis';"
                                >
                                    THÉA
                                </h1>
                                <p class="mb-2 sm:mb-3 md:mb-4 text-sm sm:text-base md:text-base lg:text-lg leading-relaxed">
                                    J'ai eu la chance d'assister deux fois aux concerts
                                    de THÉA cette année, et ces séries photographiques
                                    retranscrivent l'univers puissant de son emocore,
                                    nourri par des influences hyperpop, hardrock et
                                    techno.<br class="hidden sm:block"> </br>Théa Barromes, artiste queer autodésignée
                                    "emo-mélo-drama-queen", transforme ses tourments en
                                    une bacchanale festive. Ses textes viscéraux sur les
                                    questions queer et féministes deviennent des
                                    électrochocs technoïdes lacérés par des impacts
                                    punk.​<br class="hidden sm:block"> <br class="hidden sm:block">Les shoots, illustre l'esthétique tripartite de son
                                    univers scénique. Le rouge et le vert incarnent
                                    l'énergie punk, le bleu reflète la dimension
                                    hyperpop-techno, et le noir et blanc symbolise la
                                    mélancolie de ses textes. Ces images traduisent
                                    visuellement l'expérience d'un live de THÉA, où
                                    chaque chanson devient un exutoire collectif.
                                    
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                {/* Bloc 2 : Série RED */}
                <div>
                    <div
                        class="border-2 md:border-3 lg:border-4 border-black p-4 sm:p-5 md:p-6 lg:p-7 h-full"
                        style="background-color: #C32535;"
                    >
                        <h2
                            class="text-center text-4xl sm:text-5xl md:text-6xl lg:text-7xl mb-2 sm:mb-3"
                            style="
                                font-family: 'Climate Crisis'; 
                                background: linear-gradient(to right, #000000, #C40000);
                                -webkit-background-clip: text;
                                -webkit-text-fill-color: transparent;
                                background-clip: text;
                            "
                        >
                            RED
                        </h2>
                        <p
                            class="text-black text-sm sm:text-base md:text-base lg:text-lg font-sans leading-relaxed mb-2 sm:mb-3 md:mb-4"
                            style="
                                -webkit-text-stroke: 1px black;
                                paint-order: stroke fill;
                            "
                        >
                            La série «RED» déploie une ambiance saturée de
                            rouges profonds, où la lumière scénique taquine la
                            fumée et fait vibrer la scène d'une intensité
                            viscérale.
                        </p>
                        <p
                            class="text-black text-sm sm:text-base md:text-base lg:text-lg font-sans leading-relaxed"
                            style="
                                -webkit-text-stroke: 1px black;
                                paint-order: stroke fill;
                            "
                        >
                            Ce traitement accentue le côté explosif et
                            anarchique des concerts de THÉA, en témoignage de la
                            rage et de la communion dont elle fait preuve sur
                            scène.
                        </p>
                    </div>
                </div>

                {/* Bloc 3 : Série BLUE */}
                <div>
                    <div
                        class="p-4 sm:p-5 md:p-6 lg:p-7 h-full"
                        style="
                            background-color: #4b2ecb;
                            border: 2px solid #100d16;
                            box-shadow: inset 0 0 0 1px #100d16;
                            outline: 1px solid #100d16;
                        "
                    >
                        <h2
                            class="text-center text-4xl sm:text-5xl md:text-6xl lg:text-7xl mb-2 sm:mb-3"
                            style="
                                font-family: 'Climate Crisis'; 
                                background: linear-gradient(to right, #CB51EF, #692AAD);
                                -webkit-background-clip: text;
                                -webkit-text-fill-color: transparent;
                                background-clip: text;
                            "
                        >
                            BLUE
                        </h2>
                        <p
                            class="text-sm sm:text-base md:text-base lg:text-lg leading-relaxed"
                            style="font-family: 'Cal Sans'; color: #100d16;"
                        >
                            Les ambiances bleutées plongent dans un univers
                            onirique, où l'artiste se livre sous des halos
                            électriques. La lumière bleue accentue la
                            sensibilité hyperpop et l'aspect presque irréel du
                            moment.
                        </p>
                    </div>
                </div>

                {/* Bloc 4 : Série N & B */}
                <div>
                    <div
                        class="p-4 sm:p-5 md:p-6 lg:p-7 h-full"
                        style="
                            background-color: #0E0E0E;
                            border: 2px solid #b7b7b7;
                            box-shadow: inset 0 0 0 1px #b7b7b7;
                            outline: 1px solid #b7b7b7;
                        "
                    >
                        <h2
                            class="text-center text-4xl sm:text-5xl md:text-6xl lg:text-7xl mb-2 sm:mb-3"
                            style="
                                font-family: 'Climate Crisis'; 
                                background: linear-gradient(to right, #ffffff);
                                -webkit-background-clip: text;
                                -webkit-text-fill-color: transparent;
                                background-clip: text;
                            "
                        >
                            N & B
                        </h2>
                        <p
                            class="font-sans text-sm sm:text-base md:text-base lg:text-lg leading-relaxed"
                            style="font-family: 'Cal Sans'; color: #ffffff;"
                        >
                            Le noir et blanc révèle la part d'intimité et
                            d'émotion, mettant en avant les regards et
                            gestuelles. Ce parti-pris donne une force narrative
                            : il ramène le spectateur à l'essence du live.
                        </p>
                    </div>
                </div>

                {/* Bloc 5 : Série GREEN */}
                <div>
                    <div
                        class="p-4 sm:p-5 md:p-6 lg:p-7 h-full"
                        style="
                            background-color: #002D10;
                            border: 2px solid #008A29;
                            box-shadow: inset 0 0 0 1px #008A29;
                            outline: 1px solid #008A29;
                        "
                    >
                        <h2
                            class="text-center text-4xl sm:text-5xl md:text-6xl lg:text-7xl mb-2 sm:mb-3"
                            style="
                                font-family: 'Climate Crisis'; 
                                background: linear-gradient(to right, #BCC78D, #01D94D);
                                -webkit-background-clip: text;
                                -webkit-text-fill-color: transparent;
                                background-clip: text;
                            "
                        >
                            GREEN
                        </h2>
                        <p
                            class="font-sans text-sm sm:text-base md:text-base lg:text-lg leading-relaxed"
                            style="font-family: 'Cal Sans'; color: #ffffff;"
                        >
                            Les tons verts saturés soulignent le côté profond et
                            mystérieux du spectacle. La couleur donne une
                            dimension électro à la série, traduisant autant la
                            modernité que l'énergie brute du show.
                        </p>
                    </div>
                </div>
            </div>
        </div>

<button
  id="back-to-top"
  class="fixed bottom-4 sm:bottom-6 md:bottom-8 right-4 sm:right-6 md:right-8 cursor-pointer hover:opacity-80 hover:scale-110 transition-all z-50 bg-white/10 backdrop-blur-sm rounded-full p-2 sm:p-2.5 md:p-3 opacity-0 invisible"
  aria-label="Remonter en haut de la page"
>
  <svg 
    width="20" 
    height="20" 
    viewBox="0 0 48 48" 
    fill="none" 
    xmlns="http://www.w3.org/2000/svg" 
    class="sm:w-6 sm:h-6 md:w-8 md:h-8 lg:w-10 lg:h-10"
  >
    <path 
      d="M24 40V8M24 8L40 24M24 8L8 24" 
      stroke="white" 
      stroke-width="3" 
      stroke-linecap="round" 
      stroke-linejoin="round"
    />
  </svg>
</button>

    </Layout>

<script>
const backToTopButton = document.getElementById('back-to-top');

function toggleBackToTopButton() {
  if (window.scrollY > 300) {
    backToTopButton.classList.remove('opacity-0', 'invisible');
    backToTopButton.classList.add('opacity-100', 'visible');
  } else {
    backToTopButton.classList.add('opacity-0', 'invisible');
    backToTopButton.classList.remove('opacity-100', 'visible');
  }
}

function scrollToTop() {
  window.scrollTo({
    top: 0,
    behavior: 'smooth'
  });
}

window.addEventListener('scroll', toggleBackToTopButton);
backToTopButton.addEventListener('click', scrollToTop);
</script>
